@model LoginVM
@inject IConfiguration Config

@{
    ViewBag.Title = "Account | Login";
}

<form class="form" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    @if (ViewBag.LockoutSeconds is int lockoutSeconds)
    {
        <p id="lockout-countdown" data-seconds="@lockoutSeconds">
            Try again in <strong>@lockoutSeconds</strong> seconds.
        </p>
    }

    <label asp-for="Email"></label>
    <input asp-for="Email" autofocus>
    <span asp-validation-for="Email"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password">
    <span asp-validation-for="Password"></span>

    <br>
    <label>
        <input asp-for="RememberMe">Remember Me
    </label>
    <br>

    <div class="g-recaptcha" data-sitekey="@Config["Recaptcha:SiteKey"]"></div>

    <section>
        <button>Login</button>
        <button type="reset">Reset</button>
    </section>
</form>

@if (ViewBag.LockoutSeconds is int)
{
    <script>
        const countdown = document.getElementById('lockout-countdown');
        let seconds = Number(countdown.dataset.seconds);
        const timer = setInterval(() => {
            seconds--;
            countdown.querySelector('strong').textContent = Math.max(0, seconds);

            if (seconds <= 0) {
                clearInterval(timer);
                countdown.textContent = 'You can try logging in again now.';
            }
        }, 1000);
    </script>
}

<p>
    [ <a href="/Account/Register">Register</a> |
      <a href="/Account/ResetPassword">Reset Password</a> |
      <a href="/Account/ResendVerification">Verify Email</a> ]
</p>

@section foot {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
