@model ResetPasswordTokenVM

@{
    ViewBag.Title = "Account | Choose New Password";
}

<h2>Choose a New Password</h2>

@if (ViewBag.Message != null)
{
    <p>@ViewBag.Message</p>
    <p><a href="/Account/ResetPassword">Request a new reset link</a></p>
}
else
{
    <form class="form" method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="Token" type="hidden">

        <label asp-for="New"></label>
        <input asp-for="New">
        <span asp-validation-for="New"></span>

        <label asp-for="Confirm"></label>
        <input asp-for="Confirm">
        <span asp-validation-for="Confirm"></span>

        <section>
            <button type="submit">Reset Password</button>
            <button type="reset">Reset</button>
        </section>
    </form>
}
