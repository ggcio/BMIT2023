@model ReportFilterVM

@{
    ViewBag.Title = "Report | Index";
    DateOnly today = ViewBag.Today;
    var f = "yyyy-MM-dd";
}

<p>
    Quick:
    <a href="/Report?From=@today.AddDays(-6).ToString(f)&To=@today.ToString(f)">Last 7 days</a> |
    <a href="/Report?From=@today.AddDays(-29).ToString(f)&To=@today.ToString(f)">Last 30 days</a> |
    <a href="/Report?From=@(new DateOnly(today.Year, today.Month, 1).ToString(f))&To=@today.ToString(f)">This month</a>
</p>

<form method="get" class="form">
    <div asp-validation-summary="ModelOnly"></div>

    <label>Range</label>
    <div>
        <label><input type="radio" asp-for="Mode" value="Date"> By date</label>
        <label><input type="radio" asp-for="Mode" value="Month"> By month</label>
    </div>
    <span asp-validation-for="Mode"></span>

    <label asp-for="From"></label>
    <input asp-for="From">
    <span asp-validation-for="From"></span>

    <label asp-for="To"></label>
    <input asp-for="To">
    <span asp-validation-for="To"></span>

    <label>From Month</label>
    <div>
        <select asp-for="FromMonth" asp-items="ViewBag.MonthList"></select>
        <select asp-for="FromYear" asp-items="ViewBag.YearList"></select>
    </div>
    <span asp-validation-for="FromMonth"></span>
    <span asp-validation-for="FromYear"></span>

    <label>To Month</label>
    <div>
        <select asp-for="ToMonth" asp-items="ViewBag.MonthList"></select>
        <select asp-for="ToYear" asp-items="ViewBag.YearList"></select>
    </div>
    <span asp-validation-for="ToMonth"></span>
    <span asp-validation-for="ToYear"></span>

    <label asp-for="FacilityId"></label>
    <select asp-for="FacilityId" asp-items="ViewBag.FacilityList">
        <option value="">All</option>
    </select>

    <label asp-for="CategoryId"></label>
    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList">
        <option value="">All</option>
    </select>

    <label asp-for="GroupBy"></label>
    <select asp-for="GroupBy">
        <option value="Day">Day</option>
        <option value="Week">Week</option>
        <option value="Month">Month</option>
    </select>
    <span asp-validation-for="GroupBy"></span>

    <section>
        <button>Show</button>
        <a href="/Report">Reset</a>
    </section>
</form>

@if (ViewBag.HasData)
{
    <p>Showing @ViewBag.RangeText</p>

    <div class="cards">
        <div class="card">
            <div class="card-body">
                <p>Bookings (by slot date)</p>
                <h3>@ViewBag.Total total</h3>
                <p>Confirmed @ViewBag.Confirmed &middot; Pending @ViewBag.Pending &middot; Cancelled @ViewBag.Cancelled</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p>Net revenue (paid, not refunded)</p>
                <h3>RM @(((decimal)ViewBag.NetRevenue).ToString("0.00"))</h3>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p>Refunds (by slot date)</p>
                <h3>Refund due: @ViewBag.RefundDueCount (RM @(((decimal)ViewBag.RefundDueAmount).ToString("0.00")))</h3>
                <p>Refunded: @ViewBag.RefundedCount (RM @(((decimal)ViewBag.RefundedAmount).ToString("0.00")))</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p>Attendance (ended Confirmed slots)</p>
                <h3>Check-in rate @ViewBag.CheckInRate</h3>
                <p>Checked in @ViewBag.CheckedIn &middot; No-shows @ViewBag.NoShows</p>
            </div>
        </div>
    </div>

    @* Two charts per row where the width allows, one per row on narrow screens *@
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 20px; margin-top: 20px">
        @foreach (var id in new[] { "bookingChart", "revenueChart", "facilityRevenueChart", "categoryRevenueChart",
                                    "peakBookingChart", "peakRevenueChart", "roleChart", "hourChart" })
        {
            <div class="card">
                <div class="card-body">
                    <canvas id="@id"></canvas>
                </div>
            </div>
        }
    </div>
}

@section foot {
    @if (ViewBag.HasData)
    {
        <script src="/js/chart.umd.min.js"></script>
        <script>
            // Draw one chart: bar charts start at 0, pie charts show a legend
            function draw(id, type, title, labels, label, data, wholeNumbers) {
                new Chart($('#' + id)[0], {
                    type: type,
                    data: { labels: labels, datasets: [{ label: label, data: data }] },
                    options: {
                        plugins: { title: { display: true, text: title } },
                        scales: type == 'pie' ? {} : { y: { beginAtZero: true, ticks: { precision: wholeNumbers ? 0 : undefined } } },
                    },
                });
            }

            draw('bookingChart', 'bar', 'Bookings per Facility',
                 @Json.Serialize(ViewBag.FacilityLabels), 'Confirmed Bookings', @Json.Serialize(ViewBag.FacilityValues), true);

            draw('revenueChart', 'bar', @Json.Serialize(ViewBag.RevenueTitle),
                 @Json.Serialize(ViewBag.RevenueLabels), 'Revenue (RM)', @Json.Serialize(ViewBag.RevenueValues), false);

            draw('facilityRevenueChart', 'bar', 'Revenue (RM) by Facility',
                 @Json.Serialize(ViewBag.FacilityRevenueLabels), 'Revenue (RM)', @Json.Serialize(ViewBag.FacilityRevenueValues), false);

            draw('categoryRevenueChart', 'bar', 'Revenue (RM) by Category',
                 @Json.Serialize(ViewBag.CategoryRevenueLabels), 'Revenue (RM)', @Json.Serialize(ViewBag.CategoryRevenueValues), false);

            draw('peakBookingChart', 'pie', 'Peak vs Off-peak: Confirmed Bookings',
                 ['Peak', 'Off-peak'], 'Confirmed Bookings', @Json.Serialize(ViewBag.PeakBookingValues), true);

            draw('peakRevenueChart', 'pie', 'Peak vs Off-peak: Revenue (RM)',
                 ['Peak', 'Off-peak'], 'Revenue (RM)', @Json.Serialize(ViewBag.PeakRevenueValues), false);

            draw('roleChart', 'pie', 'Student vs Public: Confirmed Bookings',
                 ['Student', 'Public'], 'Confirmed Bookings', @Json.Serialize(ViewBag.RoleValues), true);

            draw('hourChart', 'bar', 'Busiest Hours: Confirmed Bookings',
                 @Json.Serialize(ViewBag.HourLabels), 'Confirmed Bookings', @Json.Serialize(ViewBag.HourValues), true);
        </script>
    }
}
