@model FacilityVM

@{
    ViewBag.Title = "Facility | Update";
}

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly"></div>

    @* Hidden Id lets the Remote CheckName call skip this facility *@
    <input type="hidden" asp-for="Id">

    <label asp-for="Id"></label>
    <b>@Model?.Id</b>
    <br>

    <label asp-for="Name"></label>
    <input asp-for="Name" data-trim autofocus>
    <span asp-validation-for="Name"></span>

    <label asp-for="CategoryId"></label>
    <select asp-for="CategoryId" asp-items="ViewBag.CategoryList">
        <option value="">-- Select One --</option>
    </select>
    <span asp-validation-for="CategoryId"></span>

    <label asp-for="Location"></label>
    <input asp-for="Location" data-trim>
    <span asp-validation-for="Location"></span>

    <label asp-for="Capacity"></label>
    <input asp-for="Capacity">
    <span asp-validation-for="Capacity"></span>

    <label asp-for="HourlyRate"></label>
    <input asp-for="HourlyRate">
    <span asp-validation-for="HourlyRate"></span>

    <label asp-for="PeakSurcharge"></label>
    <input asp-for="PeakSurcharge">
    <span asp-validation-for="PeakSurcharge"></span>

    <section>
        <button>Submit</button>
        <button type="reset">Reset</button>
    </section>
</form>

<h2>Photos</h2>

<form method="post" action="/Facility/AddPhotos/@Model?.Id" enctype="multipart/form-data">
    <input type="file" name="photos" accept="image/jpeg,image/png" multiple>
    <button>Upload</button>
</form>

@{
    var photos = (List<FacilityPhoto>)ViewBag.Photos;
}

@if (photos.Count == 0)
{
    <p>No photos yet.</p>
}

<div class="photo-grid">
    @foreach (var p in photos)
    {
        <div>
            <img src="/photos/@p.FileName">
            <button data-post="/Facility/DeletePhoto/@p.Id" data-confirm="Delete this photo?">Delete</button>
        </div>
    }
</div>
