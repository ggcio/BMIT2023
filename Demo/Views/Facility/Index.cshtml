@using X.PagedList
@model IPagedList<Facility>

@{
    ViewBag.Title = "Facility | Index";
}

<p>
    <a href="/Facility/Insert">Insert</a>
</p>

@* action is set so an AJAX search does not reuse the old query string in the address bar *@
<form action="/Facility"
      data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader"
      id="f">
    <input type="search" name="name" value="@ViewBag.Name" autofocus>
    <button>Search</button>
    <img src="/images/loader.gif" id="loader" style="display: none">
</form>

<div id="target">
    <partial name="_Index">
</div>
