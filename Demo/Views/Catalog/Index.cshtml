@using X.PagedList
@model IPagedList<Facility>

@{
    ViewBag.Title = "Catalog | Index";
}

<form action="/Catalog"
      data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader"
      id="f">
    <input type="search" name="name" value="@ViewBag.Name" autofocus>
    <button>Search</button>
    <img src="/images/loader.gif" id="loader" style="display: none">
</form>

<div id="target">
    <partial name="_Index">
</div>
