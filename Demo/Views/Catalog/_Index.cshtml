@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Facility>

@{
    int? categoryId = ViewBag.CategoryId;
    string name = ViewBag.Name;
    string sort = ViewBag.Sort;
    string dir = ViewBag.Dir;

    // Search and sort values kept by the category links
    string keep = $"name={Uri.EscapeDataString(name)}&sort={sort}&dir={dir}";

    // Sort field and its link text
    var fields = new Dictionary<string, string>
    {
        ["Name"]     = "Name",
        ["Rate"]     = "Hourly Rate",
        ["Capacity"] = "Capacity",
    };
}

@* Hidden fields belong to the search form "f", so searching keeps the current category and sort *@
<input type="hidden" name="categoryId" value="@categoryId" form="f">
<input type="hidden" name="sort" value="@sort" form="f">
<input type="hidden" name="dir" value="@dir" form="f">

@* Category filter chips: the selected one is shown in bold without a link *@
<p class="chips">
    @if (categoryId == null)
    {
        <b>All</b>
    }
    else
    {
        <a href="/Catalog?@keep"
           data-ajax="true"
           data-ajax-update="#target"
           data-ajax-loading="#loader">All</a>
    }

    @foreach (Category c in ViewBag.Categories)
    {
        if (c.Id == categoryId)
        {
            <b>@c.Name</b>
        }
        else
        {
            <a href="/Catalog?categoryId=@c.Id&@keep"
               data-ajax="true"
               data-ajax-update="#target"
               data-ajax-loading="#loader">@c.Name</a>
        }
    }
</p>

<p class="chips">
    Sort by:
    @foreach (var (field, text) in fields)
    {
        // Default: ascending, no arrow
        string d = "asc";
        string arrow = "";

        // Currently sorted field: show its arrow, click again to reverse
        if (field == sort)
        {
            d = dir == "des" ? "asc" : "des";
            arrow = dir == "des" ? " ▾" : " ▴";
        }

        <a href="/Catalog?categoryId=@categoryId&name=@Uri.EscapeDataString(name)&sort=@field&dir=@d"
           class="@(field == sort ? "active" : "")"
           data-ajax="true"
           data-ajax-update="#target"
           data-ajax-loading="#loader">@(text + arrow)</a>
    }
</p>

<p>
    @Model.Count() of @Model.TotalItemCount record(s) |
    Page @Model.PageNumber of @Model.PageCount
</p>

@if (!Model.Any())
{
    <p>No facilities found.</p>
}

<div class="cards">
    @foreach (var f in Model)
    {
        // First photo (lowest Id), or the default image when the facility has none
        var photo = f.Photos.OrderBy(p => p.Id).FirstOrDefault();
        string src = photo != null ? "/photos/" + photo.FileName : "/images/photo.jpg";

        <div class="card">
            <img src="@src" alt="@f.Name">
            <div class="card-body">
                <span class="badge">@f.Category.Name</span>
                <h3>@f.Name</h3>
                <p>@f.Location</p>
                <p>RM @f.HourlyRate.ToString("0.00") / hour &middot; Capacity @f.Capacity</p>
                <a href="/Catalog/Detail/@f.Id">View slots</a>
            </div>
        </div>
    }
</div>

@{
    var options = PagedListRenderOptions.ClassicPlusFirstAndLast;
    options.LinkToFirstPageFormat    = "First";
    options.LinkToLastPageFormat     = "Last";
    options.LinkToPreviousPageFormat = "Previous";
    options.LinkToNextPageFormat     = "Next";

    var ajaxOptions = new AjaxOptions
    {
        HttpMethod       = "get",
        UpdateTargetId   = "target",
        LoadingElementId = "#loader",
    };
}

@Html.PagedListPager(
    Model,
    p => $"/Catalog?categoryId={categoryId}&name={Uri.EscapeDataString(name)}&sort={sort}&dir={dir}&page={p}",
    PagedListRenderOptions.EnableUnobtrusiveAjaxReplacing(options, ajaxOptions)
)
