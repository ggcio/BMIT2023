@model Facility

@{
    ViewBag.Title = "Catalog | Detail";
}

@if (Model.Photos.Any())
{
    <p>
        @foreach (var p in Model.Photos.OrderBy(x => x.Id))
        {
            <img src="/photos/@p.FileName" width="300" height="200" alt="@Model.Name">
        }
    </p>
}

<table class="table detail">
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Category</th>
        <td>@Model.Category.Name</td>
    </tr>
    <tr>
        <th>Location</th>
        <td>@Model.Location</td>
    </tr>
    <tr>
        <th>Capacity</th>
        <td>@Model.Capacity</td>
    </tr>
    <tr>
        <th>Hourly Rate</th>
        <td>RM @Model.HourlyRate.ToString("0.00")</td>
    </tr>
    <tr>
        <th>Peak Surcharge</th>
        <td>RM @Model.PeakSurcharge.ToString("0.00")</td>
    </tr>
</table>

<p>Students (student email) book free.</p>

<img src="/images/loader.gif" id="loader" style="display: none">

<div id="slots">
    <partial name="_Slots">
</div>

@section foot {
    <script>
        // Bound on document, so it still works after AJAX replaces #slots
        $(document).on('click', '[data-slot]', e => {
            const b = e.currentTarget;

            $('.slot').removeClass('selected');
            $(b).addClass('selected');

            $('#p-time').text(b.dataset.time);
            $('#p-peak').text(b.dataset.peak);
            $('#p-price').text(b.dataset.price);
            $('#p-left').text(b.dataset.left);
            $('#book').attr('href', '/Booking/Create?slotId=' + b.dataset.slot);

            $('#panel').prop('hidden', false);
        });
    </script>
}

<p>
    <a href="/Catalog">Back to list</a>
</p>
