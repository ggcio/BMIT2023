@model CheckInVM

@{
    ViewBag.Title = "Booking | Check In";
    Booking? b = ViewBag.Booking;
}

<form method="post" class="form">
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="BookingId"></label>
    <input asp-for="BookingId" autofocus>
    <span asp-validation-for="BookingId"></span>

    <section>
        <button>Check In</button>
        <button type="reset">Reset</button>
    </section>
</form>

@if (ViewBag.Result != null)
{
    <p><b>@ViewBag.Result</b></p>
}

@if (b != null)
{
    <table class="table detail">
        <tr>
            <th>Booking ID</th>
            <td>@b.Id</td>
        </tr>
        <tr>
            <th>Member</th>
            <td>@b.User.Name</td>
        </tr>
        <tr>
            <th>Facility</th>
            <td>@b.TimeSlot.Facility.Name</td>
        </tr>
        <tr>
            <th>Date</th>
            <td>@b.TimeSlot.Date.ToString("dd MMM yyyy (ddd)")</td>
        </tr>
        <tr>
            <th>Time</th>
            <td>@b.TimeSlot.StartTime.ToString("HH:mm") - @b.TimeSlot.EndTime.ToString("HH:mm")</td>
        </tr>
    </table>
}

@{
    List<Booking> ready = ViewBag.Ready;
    List<Booking> checkedIn = ViewBag.CheckedIn;
}

<h2>Ready for check-in</h2>

@if (ready.Count == 0)
{
    <p>No bookings to check in today.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Id</th>
            <th>Member</th>
            <th>Member Type</th>
            <th>Facility</th>
            <th>Time</th>
            <th></th>
        </tr>

        @foreach (var r in ready)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.User.Name</td>
                <td>@(r.User.Role == UserRole.student ? "Student" : "Public")</td>
                <td>@r.TimeSlot.Facility.Name</td>
                <td>@r.TimeSlot.StartTime.ToString("HH:mm") - @r.TimeSlot.EndTime.ToString("HH:mm")</td>
                <td>
                    <button data-post="/AdminBooking/CheckInById/@r.Id">Check In</button>
                </td>
            </tr>
        }
    </table>
}

<h2>Checked in today</h2>

@if (checkedIn.Count == 0)
{
    <p>No one has checked in yet today.</p>
}
else
{
    <table class="table">
        <tr>
            <th>Id</th>
            <th>Member</th>
            <th>Facility</th>
            <th>Time</th>
            <th>Checked In At</th>
        </tr>

        @foreach (var c in checkedIn)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.User.Name</td>
                <td>@c.TimeSlot.Facility.Name</td>
                <td>@c.TimeSlot.StartTime.ToString("HH:mm") - @c.TimeSlot.EndTime.ToString("HH:mm")</td>
                <td>@c.CheckedInAt?.ToString("HH:mm")</td>
            </tr>
        }
    </table>
}

<p>
    <a href="/AdminBooking">Back to list</a>
</p>
