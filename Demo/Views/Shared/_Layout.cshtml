@inject DB db

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/pager.css">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    @RenderSection("head", false)
</head>
<body>
    <div class="info">@Html.Raw(TempData["Info"])</div>

    @{
        // Current controller, used to underline the current section
        string c = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        bool isMember = User.IsInRole("student") || User.IsInRole("public");
    }

    <header>
        <h1><a href="/">Campus Sports Facility Reservation</a></h1>

        <nav>
            <a href="/Catalog" class="@(c == "Catalog" ? "active" : "")">Facilities</a>

            @if (isMember)
            {
                <a href="/History" class="@(c == "History" ? "active" : "")">My Bookings</a>
            }
            @if (User.IsInRole("admin"))
            {
                <details class="dropdown @(c is "Admin" or "Category" or "Facility" or "TimeSlot" ? "active" : "")">
                    <summary>Manage</summary>
                    <div class="menu">
                        <a href="/Admin/Users">Users</a>
                        <a href="/Category">Categories</a>
                        <a href="/Facility">Facilities</a>
                        <a href="/TimeSlot">Time Slots</a>
                    </div>
                </details>
                <details class="dropdown @(c == "AdminBooking" ? "active" : "")">
                    <summary>Bookings</summary>
                    <div class="menu">
                        <a href="/AdminBooking">Bookings</a>
                        <a href="/AdminBooking/CheckIn">Check In</a>
                        <a href="/AdminBooking/Charts">Charts</a>
                    </div>
                </details>
            }
        </nav>

        <div class="account">
            @if (User.Identity!.IsAuthenticated)
            {
                string email = User.Identity.Name ?? "";
                string role = User.IsInRole("admin") ? "Admin" : User.IsInRole("student") ? "Student" : "Public";

                // Photo for student and public only; admin (or no photo) shows the first letter
                string? photoURL = isMember ? db.Users.Find(email)?.PhotoURL : null;

                <details class="dropdown">
                    <summary>
                        @if (!string.IsNullOrEmpty(photoURL))
                        {
                            <img src="/photos/@photoURL">
                        }
                        else
                        {
                            <span class="initial">@email.Substring(0, 1).ToUpper()</span>
                        }
                        <span>@email<small>@role</small></span>
                    </summary>
                    <div class="menu">
                        @if (isMember)
                        {
                            <a href="/Account/UpdateProfile">Update Profile</a>
                        }
                        <a href="/Account/UpdatePassword">Update Password</a>
                        <a href="/Account/Logout">Logout</a>
                    </div>
                </details>
            }
            else
            {
                <a href="/Account/Login">Login</a>
                <a href="/Account/Register" class="register">Register</a>
            }
        </div>
    </header>

    <main>
        @if (ViewBag.HideTitle != true)
        {
            <h1>@ViewBag.Title</h1>
        }
        @RenderBody()
    </main>

    <footer>
        Developed by <b>BAE SUZY</b> &middot;
        Copyrighted &copy; @DateTime.Today.Year
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            window.addEventListener('pageshow', event => {
                if (event.persisted) {
                    window.location.reload();
                }
            });
        </script>
    }
    @RenderSection("foot", false)
</body>
</html>
