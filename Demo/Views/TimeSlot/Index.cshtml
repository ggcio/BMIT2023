@model IEnumerable<TimeSlot>

@{
    ViewBag.Title = "Time Slot | Index";
}

<p>
    <a href="/TimeSlot/Insert" class="btn">Insert</a>
    <a href="/TimeSlot/Batch" class="btn">Generate</a>
</p>

<form method="get" class="filter">
    <select name="facilityId" asp-items="ViewBag.FacilityList">
        <option value="">-- All Facilities --</option>
    </select>
    <input type="date" name="date" value="@ViewBag.Date">
    <button>Filter</button>
</form>

<p>@Model.Count() record(s)</p>

<table class="table">
    <tr>
        <th>Id</th>
        <th>Facility</th>
        <th>Date</th>
        <th>Start-End</th>
        <th>Peak</th>
        <th>Total Bookings</th>
        <th></th>
    </tr>

    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Id</td>
            <td>@s.Facility.Name</td>
            <td>@s.Date.ToString("dd MMM yyyy (ddd)")</td>
            <td>@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")</td>
            <td>@(s.IsPeak ? "Yes" : "No")</td>
            <td>@s.Bookings.Count</td>
            <td>
                <button data-get="/TimeSlot/Update/@s.Id">Update</button>
                <button data-post="/TimeSlot/Delete/@s.Id" data-confirm="Delete this time slot?">Delete</button>
            </td>
        </tr>
    }
</table>
